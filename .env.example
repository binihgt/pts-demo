# PTS Demo - Environment Configuration
# Copy this file to .env and replace placeholders with real values.

# Flask Application
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production

# Database
# Use SQLite for local development:
DATABASE_URL=sqlite:///pts_demo.db
# For PostgreSQL in production, use:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pts_demo

# Telegram Bot
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: Set webhook URL if running in webhook mode instead of polling
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram-webhook

# Security & Session Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=28800  # 8 hours in seconds

# Rate Limiting
RATELIMIT_STORAGE_URI=memory://
