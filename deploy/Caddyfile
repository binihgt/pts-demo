# PTS Demo - Caddyfile (Automatic TLS via Let's Encrypt)
# Place in /etc/caddy/Caddyfile and run: systemctl reload caddy

demo.yourdomain.com {
    # Encode responses with gzip and zstd
    encode gzip zstd

    # Security Headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Serve static assets directly with caching
    handle_path /static/* {
        root * /var/www/pts-demo/app/static
        file_server
        header Cache-Control "public, max-age=2592000"
    }

    # Reverse proxy to Gunicorn WSGI server
    handle {
        reverse_proxy 127.0.0.1:5000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Port {server_port}
        }
    }
}
